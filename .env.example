# Bags API base URL. If Bags exposes multiple environments, point this at the one you use.
BAGS_API_BASE_URL=https://api.bags.example

# Public, doxxed chaos wallet (base58)
CHAOS_WALLET_PUBKEY=YourPublicKeyHere

# Path to a keypair json for signing transactions.
# Keep this file out of git.
SOLANA_KEYPAIR_PATH=/absolute/path/to/id.json

# Solana RPC endpoint used to send/confirm transactions.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Poll interval in milliseconds
POLL_INTERVAL_MS=2500

# Maximum SOL per action (safety cap)
MAX_SOL_PER_BUY=0.25

# Minimum protocol fees (in SOL) required before attempting any action
MIN_SOL_BALANCE=0.02

# Optional: token allowlist or denylist
ALLOWLIST=
DENYLIST=

# Database path
DB_PATH=./data/chaos.sqlite

# Logging
LOG_LEVEL=info
